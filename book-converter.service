[Unit]
Description=Book Converter (7860) + CosyVoice WebUI API (8000) - merged single process
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boom
Group=boom
WorkingDirectory=/home/boom/BookConvertToAudio
Environment="PATH=/home/boom/miniconda/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/bin/bash /home/boom/BookConvertToAudio/start.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# 可选：设置资源限制
# LimitNOFILE=65536
# LimitNPROC=4096

[Install]
WantedBy=multi-user.target

